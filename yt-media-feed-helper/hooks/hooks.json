{
  "description": "yt-media-feed-helper: diagnostics (JSONL), mutation and secret guards, informational mode, subagent wave guard; interpreter run with -I (isolated from cwd/PYTHONPATH)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/diag_log.py"
            ],
            "async": true
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session_start.py"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_tracker.py",
              "session_reset"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/info_mode_prompt.py"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/diag_log.py"
            ],
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|WebFetch|Write|Edit|MultiEdit|NotebookEdit|NotebookRead|Agent|Task|Read|Grep|Glob|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard_pretool.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/diag_log.py"
            ],
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/diag_log.py"
            ],
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/diag_log.py"
            ],
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_tracker.py",
              "start"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/diag_log.py"
            ],
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_tracker.py",
              "stop"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/diag_log.py"
            ],
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/diag_log.py"
            ],
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/diag_log.py"
            ],
            "async": true
          }
        ]
      }
    ]
  }
}
